---
import { Content } from '../../../docs/admin/README.md';
import { assetUrl } from '../../lib/content';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Administration guide - Vibeout</title>
  </head>
  <body>
    <main class="admin-shell guide">
      <a href={assetUrl('admin/', import.meta.env.BASE_URL)}>← Back to the site editor</a>
      <Content />
    </main>
  </body>
</html>
<style>
  .guide :global(h1) { font-size: clamp(2.5rem, 7vw, 3.5rem); }
  .guide :global(h2) { font-size: 1.8rem; margin-top: 2.5rem; letter-spacing: -.035em; }
  .guide :global(li) { margin-bottom: .75rem; }
  .guide :global(table) { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .guide :global(th), .guide :global(td) { text-align: left; padding: .75rem; border-bottom: 1px solid var(--line); }
  .guide :global(pre) { padding: 1rem; border-radius: 4px; overflow-x: auto; }
</style>
